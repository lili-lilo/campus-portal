# ============================================================================
# app/.env.example —— 环境变量模板（**进仓库**，供他人复制）
#
# 使用方式：
#   cp .env.example .env       # 然后把 <...> 占位符换成真实值
#
# 权威说明见 docs/环境变量.txt（含生产 Supabase 配置与"明确不需要的变量"清单）
# ============================================================================

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 本地开发（SQLite）。`file:` 相对路径由 Prisma 按 **prisma.config.ts 所在目录**解析
# （本项目为 app/），故 "./prisma/dev.db" → app/prisma/dev.db（T1.4 实测确认）。
DATABASE_URL="file:./prisma/dev.db"

# 生产（Supabase PostgreSQL）——两条串用途不同，都需要配（见 docs/11 A31）：
#   ① 运行时：走连接池（pgbouncer）
# DATABASE_URL="postgres://postgres.[REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   ② 迁移：直连（不走 pooler），仅由 prisma.config.ts 读取
# DIRECT_URL="postgres://postgres.[REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth.js v5
# ---------------------------------------------------------------------------
# 会话签名密钥。生成方式任选其一：
#   npx auth secret
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="<用上面任一方式生成，32 字节 base64>"

# 应用基础地址（Auth.js 回调、邮件链接等）
AUTH_URL="http://localhost:3000"

# 非 Vercel 环境或自托管反向代理下，需显式信任 Host 头
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# 站点公开地址（SEO：canonical / sitemap.xml / robots.txt / OG）
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# 媒体存储（生产，见 docs/11 A33 的 StorageAdapter）
# 本地开发写入 public/uploads，无需以下变量。
# ---------------------------------------------------------------------------
# SUPABASE_URL="https://[REF].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service role key，仅服务端使用，切勿加 NEXT_PUBLIC_ 前缀>"
# SUPABASE_STORAGE_BUCKET="media"

# ---------------------------------------------------------------------------
# 明确不需要的变量（记录于此，避免后来者再找）
# ---------------------------------------------------------------------------
# NEXTAUTH_SECRET / NEXTAUTH_URL  → Auth.js v5 已改用 AUTH_* 命名
# NEXT_PUBLIC_SUPABASE_ANON_KEY   → 本期不使用 Supabase Auth
# SMTP_* / SMS_*                  → 不接短信与邮件（docs/11 A1）
# ELASTICSEARCH_URL / REDIS_URL   → 不采用（docs/11 A2）
