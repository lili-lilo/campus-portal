# ============================================================================
# app/.env.example —— 环境变量模板（**进仓库**，供他人复制）
#
# 使用方式：
#   cp .env.example .env       # 然后把 <...> 占位符换成真实值
#
# 权威说明见 docs/环境变量.txt（含生产 Supabase 配置与"明确不需要的变量"清单）
# ============================================================================

# ---------------------------------------------------------------------------
# 数据库（**双轨**，M6-5 恢复；依据 docs/11 A31）
# ---------------------------------------------------------------------------
# 代码按 `DATABASE_URL` 的**前缀**自动分流（见 prisma.config.ts / src/lib/prisma.ts）：
#   file:        ⇒ 本地 SQLite（零网络，默认）
#   postgresql:  ⇒ 生产 Supabase PostgreSQL
# ⚠ **切轨后必须重跑 `pnpm prisma generate`**：两轨共用产物路径 `src/generated/prisma`，
#   而客户端与 provider 绑定（错配会报 "adapter ... is not compatible with the provider"）。
#   两份 schema 由 `node scripts/gen-sqlite-schema.mjs` 生成（仅 provider 行不同）。

# —— 本地（默认）：SQLite，零网络 ——
DATABASE_URL="file:./prisma/dev.db"

# —— 生产（Supabase）：注释上一行，启用下面两行 ——
# 取法：Supabase Dashboard → Connect → .env.local；把 [YOUR-PASSWORD] 换成数据库密码
#   DATABASE_URL —— 运行时（应用进程）用 pooler 串（端口 6543）
#   DIRECT_URL   —— Prisma CLI（generate / db push / seed）用直连/session 串（端口 5432）
# DATABASE_URL="postgresql://postgres.[REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth.js v5
# ---------------------------------------------------------------------------
# 会话签名密钥。生成方式任选其一：
#   npx auth secret
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="<用上面任一方式生成，32 字节 base64>"

# 应用基础地址（Auth.js 回调、邮件链接等）
AUTH_URL="http://localhost:3000"

# 非 Vercel 环境或自托管反向代理下，需显式信任 Host 头
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# 站点公开地址（SEO：canonical / sitemap.xml / robots.txt / OG）
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# 媒体存储（生产，见 docs/11 A33 的 StorageAdapter）
# 本地开发写入 public/uploads，无需以下变量。
# ---------------------------------------------------------------------------
# SUPABASE_URL="https://[REF].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service role key，仅服务端使用，切勿加 NEXT_PUBLIC_ 前缀>"
# SUPABASE_STORAGE_BUCKET="media"

# ---------------------------------------------------------------------------
# 明确不需要的变量（记录于此，避免后来者再找）
# ---------------------------------------------------------------------------
# NEXTAUTH_SECRET / NEXTAUTH_URL  → Auth.js v5 已改用 AUTH_* 命名
# NEXT_PUBLIC_SUPABASE_ANON_KEY   → 本期不使用 Supabase Auth
# SMTP_* / SMS_*                  → 不接短信与邮件（docs/11 A1）
# ELASTICSEARCH_URL / REDIS_URL   → 不采用（docs/11 A2）
