# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# env files
# 忽略所有真实环境变量文件，但**保留模板** .env.example（供他人复制）
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ---------------------------------------------------------------------------
# 数据库（SQLite 本地库及其日志，不进仓库）
# 实际路径为 prisma/dev.db（Prisma 按 schema.prisma 所在目录解析 file: 相对路径）
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
prisma/*.db
prisma/*.db-journal

# ---------------------------------------------------------------------------
# Prisma 生成物（构建产物，`prisma generate` 即可重建 → 不进仓库）
# 生成位置由 prisma/schema.prisma 的 generator.output 决定：../src/generated/prisma
# ---------------------------------------------------------------------------
/src/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db
